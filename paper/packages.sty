\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{packages}[2026/09/24 Third-party packages for FSE 2027]

% ============================================================
% Encoding & Fonts
% ============================================================
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[utf8]{inputenc}
  \RequirePackage[T1]{fontenc}
\fi

% ============================================================
% Math
% ============================================================
% acmart loads newtxmath, whose \Bbbk conflicts with amssymb in TeX Live 2026.
\RequirePackage{amsmath}

% ============================================================
% Algorithms
% ============================================================
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}

% ============================================================
% Graphics & Figures
% ============================================================
\RequirePackage{graphicx}
\RequirePackage{subcaption}
\RequirePackage{flafter}
\RequirePackage{placeins}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,fit,backgrounds}

% ============================================================
% Tables
% ============================================================
\RequirePackage{booktabs}
\RequirePackage{multirow}

% ============================================================
% Lists
% ============================================================
\RequirePackage{enumitem}

% ============================================================
% Text & Formatting
% ============================================================
\RequirePackage{textcomp}
\RequirePackage{xcolor}
\RequirePackage{xspace}
\RequirePackage{balance}
\RequirePackage{pifont}

% ============================================================
% Code Listings
% ============================================================
\RequirePackage{listings}

\lstset{
  basicstyle=\ttfamily\small,
  keywordstyle=\ttfamily\small,
  columns=flexible,
  keepspaces=true,
  breaklines=true,
  literate={\_}{\textunderscore\allowbreak}1,
}

% ============================================================
% References & Links
% ============================================================
\RequirePackage{url}
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    urlcolor=blue,
    hidelinks
}

% ============================================================
% Utilities
% ============================================================
\RequirePackage{etoolbox}

% Inline comments and custom commands moved to commands.sty
