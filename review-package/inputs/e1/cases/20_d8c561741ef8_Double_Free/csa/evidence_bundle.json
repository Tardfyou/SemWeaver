      },
      "semantic_payload": {
        "fact_type": "vulnerability_patterns",
        "label": "Vulnerability patterns inferred from patch",
        "attributes": {
          "patterns": [
            "double_free"
          ],
          "descriptions": [
            "On the create-SQ-ready error path, a partially initialized send queue object was cleaned up with hws_send_ring_close_sq(sq), which likely frees SQ-local allocations that are also released by the caller or later cleanup. The patch replaces that broad close routine with hws_send_ring_destroy_sq(mdev, sq), which only destroys the core SQ by sq->sqn and avoids re-freeing the local SQ allocations."
          ]
        }
      },
      "provenance": {
        "tool": "patch-analysis",
        "artifact": "vulnerability_patterns",
        "confidence": 0.95
      },
      "evidence_slice": {}
    },
