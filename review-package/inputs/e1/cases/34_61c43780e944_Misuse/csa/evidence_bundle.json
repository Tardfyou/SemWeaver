      },
      "semantic_payload": {
        "fact_type": "vulnerability_patterns",
        "label": "Vulnerability patterns inferred from patch",
        "attributes": {
          "patterns": [
            "api_misuse"
          ],
          "descriptions": [
            "Before the patch, devlink_nl_port_get_dump_one() constructed port dump replies by calling devlink_nl_port_fill() with the generic DEVLINK_CMD_NEW command value, so consumers of the generated netlink message observed a command type inconsistent with port-get responses and port notifications. After the patch, the same sink is called with DEVLINK_CMD_PORT_NEW, replacing the wrong protocol constant with the port-specific command value."
          ]
        }
      },
      "provenance": {
        "tool": "patch-analysis",
        "artifact": "vulnerability_patterns",
        "confidence": 0.95
      },
      "evidence_slice": {}
    },
