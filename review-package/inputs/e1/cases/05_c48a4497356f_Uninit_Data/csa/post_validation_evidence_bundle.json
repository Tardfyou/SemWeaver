        "fact_type": "vulnerability_patterns",
        "label": "Vulnerability patterns inferred from patch",
        "attributes": {
          "patterns": [
            "uninitialized_data_use"
          ],
          "descriptions": [
            "A local output pointer passed to request_firmware() may remain uninitialized when the request fails or is compiled out, but the old code consumed that pointer in a null check and then passed it to release_firmware(). The fix uses the request_firmware() return code as the authoritative success/failure state and returns before any fw dereference or release on failure."
          ]
        }
      },
      "provenance": {
        "tool": "patch-analysis",
        "artifact": "vulnerability_patterns",
        "confidence": 0.95
