+
+  SymbolRef LenSym = Call.getArgSVal(2).getAsSymbol();
+  if (!LenSym)
+    return false;
+
+  ProgramStateRef State = C.getState();
+  const llvm::APSInt *MaxVal =
+      State->getConstraintManager().getSymMaxVal(State, LenSym);
+  if (!MaxVal)
+    return false;
+
+  // copy_from_user's length is a size_t value. Compare both bounds as
+  // unsigned values at the same bit width.
+  unsigned Width = std::max(MaxVal->getBitWidth(), ArrSize.getBitWidth());
+  llvm::APSInt MaxUnsigned(MaxVal->zextOrTrunc(Width), /*isUnsigned=*/true);
+  llvm::APSInt ArraySizeUnsigned(ArrSize.zextOrTrunc(Width),
+                                 /*isUnsigned=*/true);
+
+  return MaxUnsigned <= ArraySizeUnsigned;
