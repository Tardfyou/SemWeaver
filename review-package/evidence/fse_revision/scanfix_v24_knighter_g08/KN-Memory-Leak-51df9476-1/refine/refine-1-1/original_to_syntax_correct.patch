+bool SAGenTestChecker::isNullPointerExpr(const Expr *E) {
+  if (!E)
+    return false;
+
+  E = E->IgnoreParenImpCasts();
+  if (isa<GNUNullExpr>(E) || isa<CXXNullPtrLiteralExpr>(E))
+    return true;
+
+  if (const auto *IL = dyn_cast<IntegerLiteral>(E))
+    return IL->getValue() == 0;
+
+  return false;
+}
+
+bool SAGenTestChecker::conditionIsNullFailureForRegion(
+    const Stmt *Condition, const MemRegion *TargetR, ProgramStateRef State,
+    CheckerContext &C) {
+  if (!Condition || !TargetR)
+    return false;
+
+  const Expr *E = dyn_cast<Expr>(Condition);
+  if (!E)
+    return false;
+  E = E->IgnoreParenImpCasts();
+
+  const Expr *PointerExpr = nullptr;
+  bool ThenMeansNull = false;
+
+  if (const auto *UO = dyn_cast<UnaryOperator>(E)) {
+    if (UO->getOpcode() == UO_LNot) {
+      PointerExpr = UO->getSubExpr()->IgnoreParenImpCasts();
+      ThenMeansNull = true;
+    }
+  } else if (const auto *BO = dyn_cast<BinaryOperator>(E)) {
+    if (BO->getOpcode() == BO_EQ &&
+        (isNullPointerExpr(BO->getLHS()) ||
+         isNullPointerExpr(BO->getRHS()))) {
+      PointerExpr = isNullPointerExpr(BO->getLHS())
+                        ? BO->getRHS()->IgnoreParenImpCasts()
+                        : BO->getLHS()->IgnoreParenImpCasts();
+      ThenMeansNull = true;
+    }
+  }
+
+  if (!PointerExpr || !ThenMeansNull)
+    return false;
+
+  DeclRefCollectorVisitor V;
+  V.TraverseStmt(const_cast<Expr *>(PointerExpr));
+
+  const MemRegion *TargetBase = TargetR->getBaseRegion();
+  const MemRegion *CanonTarget = canonicalizeRegion(State, TargetBase);
+
+  for (const DeclRefExpr *DRE : V.DeclRefs) {
+    const MemRegion *RefR = getMemRegionFromExpr(DRE, C);
+    if (!RefR)
+      continue;
+
+    RefR = RefR->getBaseRegion();
+    if (RefR == TargetBase)
+      return true;
+
+    const MemRegion *CanonRef = canonicalizeRegion(State, RefR);
+    if (CanonTarget && CanonRef == CanonTarget)
+      return true;
+  }
+
+  return false;
 }
 
