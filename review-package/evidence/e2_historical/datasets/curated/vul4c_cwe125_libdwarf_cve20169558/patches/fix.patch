-static void
-format_sig8_string(Dwarf_Sig8*data, char* str_buf,unsigned
-  buf_size)
-{
-    unsigned i = 0;
-    char *cp = str_buf;
-    if (buf_size <  19) {
-        printf("FAIL: internal coding error in test.\n");
-        exit(1);
-    }
-    strcpy(cp,"0x");
-    cp += 2;
-    buf_size -= 2;
-    for (; i < sizeof(data->signature); ++i,cp+=2,buf_size--) {
-        snprintf(cp, buf_size, "%02x",
-            (unsigned char)(data->signature[i]));
-    }
-    return;
-}
