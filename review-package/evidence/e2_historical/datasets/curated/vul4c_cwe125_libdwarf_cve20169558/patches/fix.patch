-static unsigned  char_to_uns4bit(unsigned char c)
-{
-    unsigned v;
-    if( c >= '0' && c <= '9') {
-        v =  c - '0';
-    }
-    else if( c >= 'a' && c <= 'f') {
-        v =  c - 'a' + 10;
-    }
-    else if( c >= 'A' && c <= 'F') {
-        v =  c - 'A' + 10;
-    } else {
-        printf("Garbage hex char in %c 0x%x\n",c,c);
-        exit(1);
-    }
-    return v;
-}
