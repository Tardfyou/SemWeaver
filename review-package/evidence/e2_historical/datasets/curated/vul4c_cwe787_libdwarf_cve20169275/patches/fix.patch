-static int
-inthissection(struct Dwarf_Section_s *sec,Dwarf_Small *ptr)
-{
-    if (!sec->dss_data) {
-        return FALSE;
-    }
-    if (ptr < sec->dss_data ) {
-        return FALSE;
-    }
-    if (ptr >= (sec->dss_data + sec->dss_size) ) {
-        return FALSE;
-    }
-    return TRUE;
-}
-
-#define FINDSEC(m_s,m_p,n,st,l,e)    \
-do {                                 \
-    if (inthissection((m_s),(m_p))) { \
-        *(n) = (m_s)->dss_name;      \
-        *(st)= (m_s)->dss_data;      \
-        *(l) = (m_s)->dss_size;      \
-        *(e) = (m_s)->dss_data + (m_s)->dss_size; \
-        return DW_DLV_OK;            \
-    }                                \
-} while (0)
