  "vulnerability_patterns": [
    {
      "type": "out_of_bounds_read",
      "description": "Before the patch, `index` derived from bits of `*p` was used to read `image->colormap[index]` directly. If the image colormap is too small or invalid for that index, the palette read can go out of bounds. The patch blocks this by inserting `VerifyColormapIndex(image,index);` immediately before the index is stored and used for the colormap read.",
      "trigger_conditions": [
        "`index` is assigned from `((*p) & (0x01 << bit) ? 0x01 : 0x00)`",
        "`index` is consumed as an array subscript in `image->colormap[index]`",
        "No `VerifyColormapIndex(image,index)` or equivalent colormap bounds validation occurs between index computation and colormap access",
        "The colormap may not contain the computed palette entry, especially for malformed or underspecified image data"
      ],
      "fix_patterns": [
        "Insert `VerifyColormapIndex(image,index);` after computing `index` and before `image->colormap[index]`",
        "Keep validation adjacent to the palette read so the checked value is the same value used as the subscript",
        "Apply the same validation in both the full-byte loop and the partial trailing-pixel loop"
      ],
      "affected_functions": [
        "VerifyColormapIndex"
      ],
      "cross_file": false,
      "source": "llm",
      "confidence": 0.9,
      "evidence_lines": [
        "index=((*p) & (0x01 << bit) ? 0x01 : 0x00);",
        "+              VerifyColormapIndex(image,index);",
        "indexes[x+7-bit]=index;",
        "q[x+7-bit]=image->colormap[index];",
        "for (bit=7; bit >= 0; bit--)",
        "for (bit=7; bit >= (long) (8-(image->columns % 8)); bit--)"
      ]
    }
  ],
  "cross_file_dependencies": [],
  "detection_strategy": {
    "primary_pattern": "out_of_bounds_read",
    "check_types": [
      "local_array_subscript_without_palette_validation",
      "colormap_index_bounds_guard_missing",
      "adjacent_guard_before_sink"
    ],
    "entry_points": [
      "coders/sun.c",
      "VerifyColormapIndex"
    ],
    "data_flow_tracking": false,
    "cross_file_analysis": false,
    "suggestions": [
      "首稿优先命中 patch-local sink：`image->colormap[index]` 这种 colormap 字段数组访问。",
      "把 `VerifyColormapIndex(image,index)` 作为缺失 guard 的二次收敛条件，不要首稿只查新增调用本身。",
      "重点匹配同一基本块或短 CFG 距离内：`index` 赋值后直接流入 `image->colormap[index]`。",
      "`indexes[x+7-bit]=index` 是辅助锚点，可用于确认这是 palette index 消费路径，但不是主要危险 sink。",
      "局部 AST/CFG 足够；该补丁没有体现跨文件数据流或复杂生命周期依赖。",
      "不要把 `index` 只取 0/1 当作安全证明；检测应关注 colormap 容量是否经权威校验。"
    ]
  },
