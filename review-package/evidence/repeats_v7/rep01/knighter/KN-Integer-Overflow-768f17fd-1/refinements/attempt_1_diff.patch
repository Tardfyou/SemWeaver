+  llvm::APInt MaxValue = LHSType->isUnsignedIntegerType()
+                             ? llvm::APInt::getMaxValue(Width)
+                             : llvm::APInt::getSignedMaxValue(Width);
+
+  return Value.ugt(MaxValue.lshr(ShiftAmount));
