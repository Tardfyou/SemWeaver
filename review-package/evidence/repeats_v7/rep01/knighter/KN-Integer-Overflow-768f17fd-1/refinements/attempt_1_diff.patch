+  SVal LHSVal = State->getSVal(LHS, C.getLocationContext());
+  SVal RHSVal = State->getSVal(RHS, C.getLocationContext());
+
+  auto LHSConcrete = LHSVal.getAs<nonloc::ConcreteInt>();
+  auto RHSConcrete = RHSVal.getAs<nonloc::ConcreteInt>();
